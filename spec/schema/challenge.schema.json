{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentisok.org/spec/0.1/challenge.schema.json",
  "title": "Agent Clearance Challenge",
  "description": "Exploratory AgentIsOK challenge object; not production-ready.",
  "type": "object",
  "required": [
    "protocol_version",
    "challenge_id",
    "nonce",
    "origin",
    "created_at",
    "expires_at",
    "request_binding",
    "evidence_requirements",
    "policy",
    "privacy",
    "presentation_endpoint"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.1"
    },
    "challenge_id": {
      "type": "string",
      "format": "uri",
      "maxLength": 512
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,256}$"
    },
    "origin": {
      "$ref": "#/$defs/origin"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_binding": {
      "$ref": "#/$defs/requestBinding"
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/evidenceRequirement"
      }
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "privacy": {
      "$ref": "#/$defs/privacy"
    },
    "presentation_endpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 2048
    }
  },
  "additionalProperties": false,
  "$defs": {
    "origin": {
      "type": "string",
      "pattern": "^https://[A-Za-z0-9.-]+(:[1-9][0-9]{0,4})?$",
      "maxLength": 253
    },
    "requestBinding": {
      "type": "object",
      "required": ["method", "target_uri", "action"],
      "properties": {
        "method": {
          "type": "string",
          "pattern": "^[A-Z]+$",
          "maxLength": 32
        },
        "target_uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 4096
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha-256=:[A-Za-z0-9+/=]+:$",
          "maxLength": 512
        },
        "action": {
          "$ref": "#/$defs/action"
        }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
        },
        "resource": {
          "type": "string",
          "maxLength": 1024
        },
        "constraints": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "evidenceRequirement": {
      "type": "object",
      "required": ["id", "class", "profiles", "required", "disclosures"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "class": {
          "enum": [
            "request_integrity",
            "principal",
            "delegation",
            "human_presence",
            "workload",
            "operator",
            "rate_accountability"
          ]
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 512
          }
        },
        "required": {
          "type": "boolean"
        },
        "max_age_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "disclosures": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
          }
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": ["pairwise_subject_required", "natural_language_task_forbidden"],
      "properties": {
        "pairwise_subject_required": {
          "type": "boolean"
        },
        "natural_language_task_forbidden": {
          "type": "boolean"
        },
        "retention_hint_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        }
      },
      "additionalProperties": false
    }
  }
}
