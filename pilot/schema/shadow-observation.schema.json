{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentisok.org/schema/pilot/shadow-observation-0.1.json",
  "title": "Agent Clearance shadow observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "occurred_at",
    "deployment_id",
    "route_template",
    "action_type",
    "risk_tier",
    "sample_probability",
    "incumbent_decision",
    "agent_clearance_decision",
    "reason_codes",
    "critical_obligations",
    "obligations_enforceable",
    "verification_latency_ms",
    "evidence_profiles",
    "evidence_result",
    "outcome_label",
    "label_source",
    "verifier_version",
    "policy_version",
    "error_class"
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{0,255}$"
    },
    "bounded_token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,511}$"
    }
  },
  "properties": {
    "schema_version": { "const": "0.1" },
    "event_id": { "$ref": "#/$defs/bounded_token" },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00\\.000Z$"
    },
    "deployment_id": { "$ref": "#/$defs/identifier" },
    "route_template": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^/[^?#]*$"
    },
    "action_type": { "$ref": "#/$defs/identifier" },
    "risk_tier": { "$ref": "#/$defs/identifier" },
    "sample_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "incumbent_decision": {
      "enum": ["allow", "challenge", "block", "rate_limit", "error", "unknown"]
    },
    "agent_clearance_decision": {
      "enum": ["allow", "allow_with_obligations", "step_up", "deny", "indeterminate"]
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "critical_obligations": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/bounded_token" }
    },
    "obligations_enforceable": { "type": "boolean" },
    "verification_latency_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30000
    },
    "evidence_profiles": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/bounded_token" }
    },
    "evidence_result": {
      "enum": ["valid", "invalid", "missing", "indeterminate"]
    },
    "outcome_label": { "$ref": "#/$defs/identifier" },
    "label_source": { "$ref": "#/$defs/identifier" },
    "verifier_version": { "$ref": "#/$defs/bounded_token" },
    "policy_version": { "$ref": "#/$defs/bounded_token" },
    "error_class": {
      "enum": ["none", "timeout", "evaluation_error", "invalid_result"]
    }
  }
}
